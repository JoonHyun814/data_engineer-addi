{
  "Comment": "A description of my state machine",
  "StartAt": "Delete Exists Objects",
  "States": {
    "Delete Exists Objects": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:ap-northeast-2:170217667865:function:DeleteS3Objects:prod",
        "Payload": {
          "date": "{% $states.input.date %}",
          "bucket": "{% $states.input.bucket %}",
          "dirs": "{% $states.input.athena_dirs %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Create Insert Query",
      "Assign": {
        "Date": "{% $states.input.date %}",
        "QueryType": "{% $states.input.query_type %}",
        "QueryDirs": "{% $states.input.query_dirs %}"
      }
    },
    "Create Insert Query": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": {
        "Query": "{% $states.result.Payload.generated_sql_query %}"
      },
      "Arguments": {
        "FunctionName": "arn:aws:lambda:ap-northeast-2:170217667865:function:CreateAthenaQuery:prod",
        "Payload": {
          "date": "{% $Date %}",
          "query_type": "{% $QueryType %}",
          "dirs": "{% $QueryDirs %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "Run Query"
    },
    "Run Query": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:startQueryExecution",
      "Arguments": {
        "QueryString": "{% $states.input.Query %}",
        "WorkGroup": "primary",
        "ResultConfiguration": {
          "OutputLocation": "s3://ptbwa-athena/query/output/"
        }
      },
      "Next": "Run Query Status",
      "Assign": {
        "QueryExecutionId": "{% $states.result.QueryExecutionId %}"
      }
    },
    "Run Query Status": {
      "Type": "Task",
      "Resource": "arn:aws:states:::athena:getQueryExecution",
      "Arguments": {
        "QueryExecutionId": "{% $QueryExecutionId %}"
      },
      "Next": "Run Query Status Choice",
      "Output": {
        "QueryExecutionStatus": "{% $states.result.QueryExecution.Status.State %}"
      }
    },
    "Run Query Status Choice": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.QueryExecutionStatus = 'SUCCEEDED'%}",
          "Next": "Run Query Success"
        },
        {
          "Next": "Run Query Wait",
          "Condition": "{% $states.input.QueryExecutionStatus = 'QUEUED' or $states.input.QueryExecutionStatus = 'RUNNING' %}"
        }
      ],
      "Default": "Run Query Fail"
    },
    "Run Query Wait": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "Run Query Status"
    },
    "Run Query Success": {
      "Type": "Succeed"
    },
    "Run Query Fail": {
      "Type": "Fail"
    }
  },
  "QueryLanguage": "JSONata"
}