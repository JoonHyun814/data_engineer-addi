{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecretsManager",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-northeast-2:170217667865:secret:database*"
    },
    {
      "Sid": "S3",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::ptbwa-da",
        "arn:aws:s3:::ptbwa-da/prod/*",
        "arn:aws:s3:::ptbwa-dw",
        "arn:aws:s3:::ptbwa-dw/prod/*"
      ]
    },
    {
      "Sid": "Glue",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:CreateTable"
      ],
      "Resource": [
        "arn:aws:glue:ap-northeast-2:170217667865:catalog",
        "arn:aws:glue:ap-northeast-2:170217667865:database/*",
        "arn:aws:glue:ap-northeast-2:170217667865:table/*/*"
      ]
    },
    {
      "Sid": "VPCNetworkInterface",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DeleteNetworkInterface"
      ],
      "Resource": "*"
    }
  ]
}
