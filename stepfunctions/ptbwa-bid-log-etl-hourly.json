            "Run APM Bid Crawler": {
              "Type": "Task",
              "Arguments": {
                "Name": "ptbwa-apm-bid-hourly"
              },
              "Resource": "arn:aws:states:::aws-sdk:glue:startWorkflowRun",
              "Next": "APM Bid Crawler Status",
              "Assign": {
                "ApmBidCrawlerRunId": "{% $states.result.RunId %}"
              },
              "Catch": [
