                }
              ],
              "Next": "APM Bid Crawler Last Status"
            },
            "APM Flatten": {
              "Type": "Task",
              "Resource": "arn:aws:states:::states:startExecution.sync:2",
              "Arguments": {
                "StateMachineArn": "arn:aws:states:ap-northeast-2:170217667865:stateMachine:athena-insert-data:prod",
                "Input": {
                  "date": "{% $Date %}",
                  "bucket": "ptbwa-dw",
                  "athena_dirs": "prod/apm_bid_log_flatten",
                  "query_type": "prod-apm_bid_log_flatten",
                  "query_dirs": "ptbwa"
                }
              },
              "End": true,
              "Catch": [
                {
                  "ErrorEquals": [
                    "States.TaskFailed"
                  ],
                  "Next": "APMBid Crawler End"
                }
              ]
            }
          }
        },
        {
          "StartAt": "NHN Bid",
          "States": {
            "NHN Bid": {
              "Type": "Task",
              "Arguments": {
                "Bucket": "propfit-bid-logs",
                "Prefix": "{% $join(['nhn/propfit_log/nhn_bid_log/year=',$split($split($Date, ' ', 1)[0], '-')[0],'/month=', $split($split($Date, ' ', 1)[0], '-')[1],'/day=',$split($split($Date, ' ', 1)[0], '-')[2],'/hour=',$split($split($Date, ' ', 2)[1], ':')[0]]) %}"
              },
              "Resource": "arn:aws:states:::aws-sdk:s3:listObjectsV2",
              "Next": "NHN Bid ELB",
              "Output": {
                "S3Logs": "{% $states.result %}"
              }
            },
            "NHN Bid ELB": {
              "Type": "Task",
              "Arguments": {
                "TargetGroupArn": "arn:aws:elasticloadbalancing:ap-northeast-2:170217667865:targetgroup/propfit-v2-bidder-tg/94e0ce7a9295c11d"
              },
              "Resource": "arn:aws:states:::aws-sdk:elasticloadbalancingv2:describeTargetHealth",
              "Next": "Compare Num of NHN Bid Log and Num of ELB Instance",
              "Output": {
                "S3Logs": "{% $states.input.S3Logs %}",
                "ElbTargetHealthDescriptions": "{% $states.result %}",
                "S3KeyCount": "{% $states.input.S3Logs.KeyCount %}",
                "TargetHelthyId": "{% $states.result.TargetHealthDescriptions[TargetHealth.State='healthy'].Target.Id %}"
              }
            },
            "Compare Num of NHN Bid Log and Num of ELB Instance": {
              "Type": "Choice",
              "Choices": [
                {
                  "Next": "NHN Log Missing Alert",
                  "Condition": "{% ($states.input.S3KeyCount>0) and ($count($states.input.S3Logs.Contents[$contains(Key, '_w0.log.gz')])) < ($count($states.input.TargetHelthyId)) %}",
                  "Output": {
                    "S3Logs": "{% $states.input.S3Logs %}",
                    "ElbTargetHealthDescriptions": "{% $states.input.ElbTargetHealthDescriptions %}"
                  }
                },
                {
                  "Next": "NHN Bid Crawler End",
                  "Condition": "{% $states.input.S3Logs.KeyCount=0 %}"
                }
