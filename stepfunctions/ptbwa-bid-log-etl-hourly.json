            },
            "NHN Bid Crawler Status": {
              "Type": "Task",
              "Arguments": {
                "Name": "ptbwa-nhn-bid",
                "RunId": "{% $NhnBidCrawlerRunId %}"
              },
              "Resource": "arn:aws:states:::aws-sdk:glue:getWorkflowRun",
              "Next": "NHN Bid Crawler Status Choice"
            },
