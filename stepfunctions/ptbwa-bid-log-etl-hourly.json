            "APM Bid Crawler Status": {
              "Type": "Task",
              "Arguments": {
                "Name": "ptbwa-apm-bid-hourly",
                "RunId": "{% $ApmBidCrawlerRunId %}"
              },
              "Resource": "arn:aws:states:::aws-sdk:glue:getWorkflowRun",
              "Next": "APM Bid Crawler Status Choice"
            },
            "APM Bid Crawler Status Choice": {
              "Type": "Choice",
              "Choices": [
                {
                  "Next": "APM Bid Crawler Wait",
                  "Condition": "{% $states.input.Run.Status=\"RUNNING\" or $states.input.Run.Status=\"STOPPING\" %}"
                },
                {
                  "Next": "APM Flatten",
                  "Condition": "{% $states.input.Run.Status=\"COMPLETED\" %}"
                },
                {
                  "Next": "APMBid Crawler End",
                  "Condition": "{% $states.input.Run.Status=\"STOPPED\" %}"
                }
              ],
              "Default": "APMBid Crawler End"
            },
            "APM Bid Crawler Wait": {
              "Type": "Wait",
              "Seconds": 30,
              "Next": "APM Bid Crawler Status"
            },
            "APMBid Crawler End": {
              "Type": "Pass",
              "End": true
            },
            "APM Log Missing Alert": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Output": "{% $states.result.Payload %}",
              "Arguments": {
                "FunctionName": "arn:aws:lambda:ap-northeast-2:170217667865:function:PtbwaLogMissingAlert:prod",
                "Payload": {
