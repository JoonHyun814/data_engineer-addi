                    "S3Logs": "{% $states.input.S3Logs %}",
                    "ElbTargetHealthDescriptions": "{% $states.input.ElbTargetHealthDescriptions %}"
                  }
                },
                {
                  "Next": "APMBid Crawler End",
                  "Condition": "{% $states.input.S3Logs.KeyCount=0 %}"
                }
              ],
              "Default": "APM Bid Crawler Last Status"
            },
            "APM Bid Crawler Last Status": {
              "Type": "Task",
              "Arguments": {
                "Name": "ptbwa-apm-bid-hourly"
              },
              "Resource": "arn:aws:states:::aws-sdk:glue:getWorkflow",
              "Next": "APM Bid Crawler Last Status Choice",
              "Output": {
                "LastRunStatus": "{% $states.result.Workflow.LastRun.Status %}"
              }
            },
            "APM Bid Crawler Last Status Choice": {
              "Type": "Choice",
              "Choices": [
                {
                  "Next": "Run APM Bid Crawler",
