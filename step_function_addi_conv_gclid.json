{
  "Comment": "Addi Conv GCLID: Google Ads -> S3/Athena -> RDS (매일 07:00 KST, 전날 데이터)",
  "StartAt": "CheckDateInput",
  "States": {
    "CheckDateInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.date",
          "IsPresent": true,
          "Next": "RunGlueJobAthena"
        }
      ],
      "Default": "GetDate"
    },
    "GetDate": {
      "Type": "Pass",
      "Parameters": {
        "date.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)"
      },
      "Next": "RunGlueJobAthena"
    },
    "RunGlueJobAthena": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "addi_conv_gclid_youtube_test",
        "Arguments": {
          "--start_date.$": "$.date",
          "--end_date.$": "$.date"
        }
      },
      "ResultPath": null,
      "Next": "RunGlueJobRDS",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "JobFailed"
        }
      ]
    },
    "RunGlueJobRDS": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "insert-athena-data-to-rdb",
        "Arguments": {
          "--athena_result_base_path": "s3://ptbwa-da/prod/addi_conv_gclid_youtube",
          "--date.$": "$.date",
          "--athena_db": "prod_addi_conv",
          "--athena_table": "addi_conv_gclid_youtube",
          "--rdb_db": "addi",
          "--rdb_table": "addi_conv_gclid_youtube"
        }
      },
      "ResultPath": null,
      "End": true,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "JobFailed"
        }
      ]
    },
    "JobFailed": {
      "Type": "Fail",
      "Error": "GlueJobFailed",
      "Cause": "One of the Glue jobs failed. Check CloudWatch Logs for details."
    }
  }
}
