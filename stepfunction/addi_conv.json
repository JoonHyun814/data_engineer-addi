{
  "Comment": "Addi Conv GAD YouTube: GCLID + Metric 병렬 적재 후 Report 병렬 적재 (매일 07:00 KST, 전날 데이터)",
  "StartAt": "CheckDateInput",
  "States": {
    "CheckDateInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.start_date",
          "IsPresent": true,
          "Next": "RunParallel"
        },
        {
          "Variable": "$.date",
          "IsPresent": true,
          "Next": "SetSingleDate"
        }
      ],
      "Default": "GetYesterday"
    },
    "GetYesterday": {
      "Type": "Pass",
      "Parameters": {
        "start_date.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)",
        "end_date.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)"
      },
      "Next": "RunParallel"
    },
    "SetSingleDate": {
      "Type": "Pass",
      "Parameters": {
        "start_date.$": "$.date",
        "end_date.$": "$.date"
      },
      "Next": "RunParallel"
    },
    "RunParallel": {
      "Type": "Parallel",
      "Branches": [
        {
          "Comment": "GCLID Pipeline",
          "StartAt": "RunGlueJobGCLID",
          "States": {
            "RunGlueJobGCLID": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "addi_conv_gclid_youtube_test",
                "Arguments": {
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        },
        {
          "Comment": "Metric Pipeline",
          "StartAt": "RunGlueJobMetric",
          "States": {
            "RunGlueJobMetric": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "addi_conv_metric_youtube",
                "Arguments": {
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        },
        {
          "Comment": "RDS to Athena Full Refresh → raw_conv_web + raw_conv_web_imp 병렬 적재",
          "StartAt": "RunRDStoAthenaFullRefresh",
          "States": {
            "RunRDStoAthenaFullRefresh": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:ap-northeast-2:170217667865:function:RDStoAthena_FullRefresh",
              "Parameters": {
                "secret_name": "database_addi",
                "db_name": "addi",
                "table_name": "addi_conv_info",
                "glue_db": "prod_addi_conv",
                "glue_table": "addi_conv_info",
                "s3_bucket": "ptbwa-da",
                "s3_prefix": "prod/addi_conv_info"
              },
              "ResultPath": null,
              "Next": "RunInsertRawConvParallel"
            },
            "RunInsertRawConvParallel": {
              "Type": "Parallel",
              "Branches": [
                {
                  "Comment": "raw_conv_web, athena-insert-data 공용 상태머신으로 날짜별 순차 적재",
                  "StartAt": "BuildRawConvWebDateList",
                  "States": {
                    "BuildRawConvWebDateList": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::lambda:invoke",
                      "Parameters": {
                        "FunctionName": "DateUtil",
                        "Payload": {
                          "start_date.$": "$.start_date",
                          "end_date.$": "$.end_date"
                        }
                      },
                      "ResultSelector": {
                        "date_list.$": "$.Payload.date_list"
                      },
                      "ResultPath": "$",
                      "Next": "RunInsertRawConvWeb"
                    },
                    "RunInsertRawConvWeb": {
                      "Comment": "raw_conv_web: date_list의 날짜별로 하루씩 순차 적재",
                      "Type": "Map",
                      "ItemsPath": "$.date_list",
                      "MaxConcurrency": 1,
                      "ItemSelector": {
                        "date.$": "$$.Map.Item.Value"
                      },
                      "ItemProcessor": {
                        "ProcessorConfig": {
                          "Mode": "INLINE"
                        },
                        "StartAt": "RunInsertRawConvWebPerDate",
                        "States": {
                          "RunInsertRawConvWebPerDate": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::states:startExecution.sync:2",
                            "Parameters": {
                              "StateMachineArn": "arn:aws:states:ap-northeast-2:170217667865:stateMachine:athena-insert-data:prod",
                              "Input": {
                                "date.$": "$.date",
                                "bucket": "ptbwa-da",
                                "athena_dirs": "prod/prod_addi_conv/raw_conv_web",
                                "query_dirs": "ptbwa",
                                "query_type": "prod-addi_conv_raw_conv_web"
                              }
                            },
                            "End": true
                          }
                        }
                      },
                      "ResultPath": null,
                      "End": true
                    }
                  }
                },
                {
                  "Comment": "raw_conv_web_v2, athena-insert-data 공용 상태머신으로 날짜별 순차 적재",
                  "StartAt": "BuildRawConvWebV2DateList",
                  "States": {
                    "BuildRawConvWebV2DateList": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::lambda:invoke",
                      "Parameters": {
                        "FunctionName": "DateUtil",
                        "Payload": {
                          "start_date.$": "$.start_date",
                          "end_date.$": "$.end_date"
                        }
                      },
                      "ResultSelector": {
                        "date_list.$": "$.Payload.date_list"
                      },
                      "ResultPath": "$",
                      "Next": "RunInsertRawConvWeb_v2"
                    },
                    "RunInsertRawConvWeb_v2": {
                      "Comment": "raw_conv_web_v2: date_list의 날짜별로 하루씩 순차 적재",
                      "Type": "Map",
                      "ItemsPath": "$.date_list",
                      "MaxConcurrency": 1,
                      "ItemSelector": {
                        "date.$": "$$.Map.Item.Value"
                      },
                      "ItemProcessor": {
                        "ProcessorConfig": {
                          "Mode": "INLINE"
                        },
                        "StartAt": "RunInsertRawConvWebV2PerDate",
                        "States": {
                          "RunInsertRawConvWebV2PerDate": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::states:startExecution.sync:2",
                            "Parameters": {
                              "StateMachineArn": "arn:aws:states:ap-northeast-2:170217667865:stateMachine:athena-insert-data:prod",
                              "Input": {
                                "date.$": "$.date",
                                "bucket": "ptbwa-da",
                                "athena_dirs": "prod/prod_addi_conv/raw_conv_web_v2",
                                "query_dirs": "ptbwa",
                                "query_type": "prod-addi_conv_raw_conv_web_v2"
                              }
                            },
                            "End": true
                          }
                        }
                      },
                      "ResultPath": null,
                      "End": true
                    }
                  }
                },
                {
                  "Comment": "raw_conv_web_imp, athena-insert-data 공용 상태머신으로 날짜별 순차 적재",
                  "StartAt": "BuildRawConvWebImpDateList",
                  "States": {
                    "BuildRawConvWebImpDateList": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::lambda:invoke",
                      "Parameters": {
                        "FunctionName": "DateUtil",
                        "Payload": {
                          "start_date.$": "$.start_date",
                          "end_date.$": "$.end_date"
                        }
                      },
                      "ResultSelector": {
                        "date_list.$": "$.Payload.date_list"
                      },
                      "ResultPath": "$",
                      "Next": "RunInsertRawConvWebImp"
                    },
                    "RunInsertRawConvWebImp": {
                      "Comment": "raw_conv_web_imp: date_list의 날짜별로 하루씩 순차 적재",
                      "Type": "Map",
                      "ItemsPath": "$.date_list",
                      "MaxConcurrency": 1,
                      "ItemSelector": {
                        "date.$": "$$.Map.Item.Value"
                      },
                      "ItemProcessor": {
                        "ProcessorConfig": {
                          "Mode": "INLINE"
                        },
                        "StartAt": "RunInsertRawConvWebImpPerDate",
                        "States": {
                          "RunInsertRawConvWebImpPerDate": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::states:startExecution.sync:2",
                            "Parameters": {
                              "StateMachineArn": "arn:aws:states:ap-northeast-2:170217667865:stateMachine:athena-insert-data:prod",
                              "Input": {
                                "date.$": "$.date",
                                "bucket": "ptbwa-da",
                                "athena_dirs": "prod/prod_addi_conv/raw_conv_web_imp",
                                "query_dirs": "ptbwa",
                                "query_type": "prod-addi_conv_raw_conv_web_imp"
                              }
                            },
                            "End": true
                          }
                        }
                      },
                      "ResultPath": null,
                      "End": true
                    }
                  }
                },
                {
                  "Comment": "raw_conv_web_v3, athena-insert-data 공용 상태머신으로 날짜별 순차 적재",
                  "StartAt": "BuildRawConvWebV3DateList",
                  "States": {
                    "BuildRawConvWebV3DateList": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::lambda:invoke",
                      "Parameters": {
                        "FunctionName": "DateUtil",
                        "Payload": {
                          "start_date.$": "$.start_date",
                          "end_date.$": "$.end_date"
                        }
                      },
                      "ResultSelector": {
                        "date_list.$": "$.Payload.date_list"
                      },
                      "ResultPath": "$",
                      "Next": "RunInsertRawConvWeb_v3"
                    },
                    "RunInsertRawConvWeb_v3": {
                      "Comment": "raw_conv_web_v3: date_list의 날짜별로 하루씩 순차 적재",
                      "Type": "Map",
                      "ItemsPath": "$.date_list",
                      "MaxConcurrency": 1,
                      "ItemSelector": {
                        "date.$": "$$.Map.Item.Value"
                      },
                      "ItemProcessor": {
                        "ProcessorConfig": {
                          "Mode": "INLINE"
                        },
                        "StartAt": "RunInsertRawConvWebV3PerDate",
                        "States": {
                          "RunInsertRawConvWebV3PerDate": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::states:startExecution.sync:2",
                            "Parameters": {
                              "StateMachineArn": "arn:aws:states:ap-northeast-2:170217667865:stateMachine:athena-insert-data:prod",
                              "Input": {
                                "date.$": "$.date",
                                "bucket": "ptbwa-da",
                                "athena_dirs": "prod/prod_addi_conv/raw_conv_web_v3",
                                "query_dirs": "ptbwa",
                                "query_type": "prod-addi_conv_raw_conv_web_v3"
                              }
                            },
                            "End": true
                          }
                        }
                      },
                      "ResultPath": null,
                      "End": true
                    }
                  }
                },
                {
                  "Comment": "raw_conv_new (ABI + STB_MOBILE_MAPPING 통합), athena-insert-data 공용 상태머신으로 날짜별 순차 적재",
                  "StartAt": "BuildRawConvNewDateList",
                  "States": {
                    "BuildRawConvNewDateList": {
                      "Type": "Task",
                      "Resource": "arn:aws:states:::lambda:invoke",
                      "Parameters": {
                        "FunctionName": "DateUtil",
                        "Payload": {
                          "start_date.$": "$.start_date",
                          "end_date.$": "$.end_date"
                        }
                      },
                      "ResultSelector": {
                        "date_list.$": "$.Payload.date_list"
                      },
                      "ResultPath": "$",
                      "Next": "RunInsertRawConvNew"
                    },
                    "RunInsertRawConvNew": {
                      "Comment": "raw_conv_new: date_list의 날짜별로 하루씩 순차 적재",
                      "Type": "Map",
                      "ItemsPath": "$.date_list",
                      "MaxConcurrency": 1,
                      "ItemSelector": {
                        "date.$": "$$.Map.Item.Value"
                      },
                      "ItemProcessor": {
                        "ProcessorConfig": {
                          "Mode": "INLINE"
                        },
                        "StartAt": "RunInsertRawConvNewPerDate",
                        "States": {
                          "RunInsertRawConvNewPerDate": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::states:startExecution.sync:2",
                            "Parameters": {
                              "StateMachineArn": "arn:aws:states:ap-northeast-2:170217667865:stateMachine:athena-insert-data:prod",
                              "Input": {
                                "date.$": "$.date",
                                "bucket": "ptbwa-da",
                                "athena_dirs": "prod/prod_addi_conv/raw_conv_new",
                                "query_dirs": "ptbwa",
                                "query_type": "prod-addi_conv_raw_conv_new"
                              }
                            },
                            "End": true
                          }
                        }
                      },
                      "ResultPath": null,
                      "End": true
                    }
                  }
                }
              ],
              "ResultPath": null,
              "End": true
            }
          }
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "JobFailed"
        }
      ],
      "Next": "RunInsertParallel"
    },
    "RunInsertParallel": {
      "Type": "Parallel",
      "Branches": [
        {
          "Comment": "Insert report_addi_conv_metric_youtube",
          "StartAt": "SetMetricYoutubeDateRange",
          "States": {
            "SetMetricYoutubeDateRange": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "DateUtil",
                "Payload": {
                  "end_date.$": "$.end_date",
                  "date_diff": 14
                }
              },
              "ResultSelector": {
                "start_date.$": "$.Payload.start_date",
                "end_date.$": "$.Payload.end_date"
              },
              "ResultPath": "$",
              "Next": "RunInsertMetricYoutube"
            },
            "RunInsertMetricYoutube": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "prod_addi_conv_insert_Athena_range",
                "Arguments": {
                  "--s3_query_path": "s3://ptbwa-da/prod/prod_addi_conv/query/report_addi_conv_metric_youtube_range.sql",
                  "--athena_table": "report_addi_conv_metric_youtube",
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "Next": "RunRdbMetricYoutube"
            },
            "RunRdbMetricYoutube": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "insert-athena-data-to-rdb-range",
                "Arguments": {
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date",
                  "--athena_result_base_path": "s3://ptbwa-da/prod/prod_addi_conv/report_addi_conv_metric_youtube",
                  "--athena_db": "prod_addi_conv",
                  "--athena_table": "report_addi_conv_metric_youtube",
                  "--rdb_db": "addi",
                  "--rdb_table": "report_addi_conv_metric_youtube"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        },
        {
          "Comment": "Insert report_addi_conv_gtm_youtube",
          "StartAt": "RunInsertGtmYoutube",
          "States": {
            "RunInsertGtmYoutube": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "prod_addi_conv_insert_Athena",
                "Arguments": {
                  "--s3_query_path": "s3://ptbwa-da/prod/prod_addi_conv/query/report_addi_conv_gtm_youtube.sql",
                  "--athena_table": "report_addi_conv_gtm_youtube",
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "Next": "RunRdbGtmYoutube"
            },
            "RunRdbGtmYoutube": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "insert-athena-data-to-rdb-range",
                "Arguments": {
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date",
                  "--athena_result_base_path": "s3://ptbwa-da/prod/prod_addi_conv/report_addi_conv_gtm_youtube",
                  "--athena_db": "prod_addi_conv",
                  "--athena_table": "report_addi_conv_gtm_youtube",
                  "--rdb_db": "addi",
                  "--rdb_table": "report_addi_conv_gtm_youtube"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        },
        {
          "Comment": "Insert report_addi_conv_app",
          "StartAt": "RunInsertApp",
          "States": {
            "RunInsertApp": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "prod_addi_conv_insert_Athena",
                "Arguments": {
                  "--s3_query_path": "s3://ptbwa-da/prod/prod_addi_conv/query/report_addi_conv_app.sql",
                  "--athena_table": "report_addi_conv_app",
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "Next": "RunRdbApp"
            },
            "RunRdbApp": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "insert-athena-data-to-rdb-range",
                "Arguments": {
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date",
                  "--athena_result_base_path": "s3://ptbwa-da/prod/prod_addi_conv/report_addi_conv_app",
                  "--athena_db": "prod_addi_conv",
                  "--athena_table": "report_addi_conv_app",
                  "--rdb_db": "addi",
                  "--rdb_table": "report_addi_conv_app"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        },
        {
          "Comment": "Insert raw_conv_web → report_addi_conv_gtm_web",
          "StartAt": "RunInsertGtmWeb",
          "States": {
            "RunInsertGtmWeb": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "prod_addi_conv_insert_Athena",
                "Arguments": {
                  "--s3_query_path": "s3://ptbwa-da/prod/prod_addi_conv/query/report_addi_conv_gtm_web.sql",
                  "--athena_table": "report_addi_conv_gtm_web",
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "Next": "RunRdbGtmWeb"
            },
            "RunRdbGtmWeb": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "insert-athena-data-to-rdb-range",
                "Arguments": {
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date",
                  "--athena_result_base_path": "s3://ptbwa-da/prod/prod_addi_conv/report_addi_conv_gtm_web",
                  "--athena_db": "prod_addi_conv",
                  "--athena_table": "report_addi_conv_gtm_web",
                  "--rdb_db": "addi",
                  "--rdb_table": "report_addi_conv_gtm_web"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        },
        {
          "Comment": "Insert raw_conv_web_imp → report_addi_conv_gtm_web_imp",
          "StartAt": "RunInsertGtmWebImp",
          "States": {
            "RunInsertGtmWebImp": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "prod_addi_conv_insert_Athena",
                "Arguments": {
                  "--s3_query_path": "s3://ptbwa-da/prod/prod_addi_conv/query/report_addi_conv_gtm_web_imp.sql",
                  "--athena_table": "report_addi_conv_gtm_web_imp",
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "JobFailed"
        }
      ],
      "End": true
    },
    "JobFailed": {
      "Type": "Fail",
      "Error": "GlueJobFailed",
      "Cause": "One of the Glue jobs failed. Check CloudWatch Logs for details."
    }
  }
}