{
  "Comment": "Addi Conv GAD YouTube: RDS to Athena Full Refresh 후 raw_conv_web_home 적재 (기본: 실행 시점의 KST 오늘 날짜 / 입력에 date가 있으면 해당 날짜로, start_date+end_date가 있으면 그 범위로 하루씩 적재)",
  "StartAt": "CheckDateInput",
  "States": {
    "CheckDateInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.start_date",
          "IsPresent": true,
          "Next": "BuildDateList"
        },
        {
          "Variable": "$.date",
          "IsPresent": true,
          "Next": "SetSingleDate"
        }
      ],
      "Default": "GetTodayKST"
    },
    "SetSingleDate": {
      "Comment": "테스트/백필용: 실행 입력의 date 하나로 override",
      "Type": "Pass",
      "Parameters": {
        "start_date.$": "$.date",
        "end_date.$": "$.date"
      },
      "Next": "BuildDateList"
    },
    "GetTodayKST": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DateUtil",
        "Payload": {
          "date_diff": 0
        }
      },
      "ResultSelector": {
        "start_date.$": "$.Payload.start_date",
        "end_date.$": "$.Payload.end_date"
      },
      "ResultPath": "$",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "JobFailed"
        }
      ],
      "Next": "BuildDateList"
    },
    "BuildDateList": {
      "Comment": "start_date~end_date 사이 모든 날짜를 date_list 배열로 생성. DateUtil Lambda(Python list)로 만든다 — JSONata Pass state는 원소 1개짜리 배열이 스칼라로 축약되는 이슈가 있어 사용하지 않는다.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DateUtil",
        "Payload": {
          "start_date.$": "$.start_date",
          "end_date.$": "$.end_date"
        }
      },
      "ResultSelector": {
        "start_date.$": "$.Payload.start_date",
        "end_date.$": "$.Payload.end_date",
        "date_list.$": "$.Payload.date_list"
      },
      "ResultPath": "$",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "JobFailed"
        }
      ],
      "Next": "RunRDStoAthenaFullRefresh"
    },
    "RunRDStoAthenaFullRefresh": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-northeast-2:170217667865:function:RDStoAthena_FullRefresh",
      "Parameters": {
        "secret_name": "database_addi",
        "db_name": "addi",
        "table_name": "addi_conv_info",
        "glue_db": "prod_addi_conv",
        "glue_table": "addi_conv_info",
        "s3_bucket": "ptbwa-da",
        "s3_prefix": "prod/addi_conv_info"
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "JobFailed"
        }
      ],
      "Next": "RunInsertRawConvWebHome"
    },
    "RunInsertRawConvWebHome": {
      "Comment": "raw_conv_web_home: date_list의 날짜별로 하루씩 순차 적재",
      "Type": "Map",
      "ItemsPath": "$.date_list",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "date.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "RunInsertRawConvWebHomePerDate",
        "States": {
          "RunInsertRawConvWebHomePerDate": {
            "Type": "Task",
            "Resource": "arn:aws:states:::states:startExecution.sync:2",
            "Parameters": {
              "StateMachineArn": "arn:aws:states:ap-northeast-2:170217667865:stateMachine:athena-insert-data:prod",
              "Input": {
                "date.$": "$.date",
                "bucket": "ptbwa-da",
                "athena_dirs": "prod/prod_addi_conv/raw_conv_web_home",
                "query_dirs": "ptbwa",
                "query_type": "prod-addi_conv_raw_conv_web_home"
              }
            },
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "JobFailed"
        }
      ],
      "End": true
    },
    "JobFailed": {
      "Type": "Fail",
      "Error": "StepFailed",
      "Cause": "GetTodayKST, RDStoAthena_FullRefresh, Glue Job 중 하나가 실패했습니다. CloudWatch Logs를 확인하세요."
    }
  }
}
