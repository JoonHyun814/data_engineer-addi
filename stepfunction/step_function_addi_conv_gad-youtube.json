{
  "Comment": "Addi Conv GAD YouTube: GCLID + Metric 병렬 적재 (매일 07:00 KST, 전날 데이터)",
  "StartAt": "CheckDateInput",
  "States": {
    "CheckDateInput": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.start_date",
          "IsPresent": true,
          "Next": "RunParallel"
        },
        {
          "Variable": "$.date",
          "IsPresent": true,
          "Next": "SetSingleDate"
        }
      ],
      "Default": "GetYesterday"
    },
    "GetYesterday": {
      "Type": "Pass",
      "Parameters": {
        "start_date.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)",
        "end_date.$": "States.ArrayGetItem(States.StringSplit($$.Execution.StartTime, 'T'), 0)"
      },
      "Next": "RunParallel"
    },
    "SetSingleDate": {
      "Type": "Pass",
      "Parameters": {
        "start_date.$": "$.date",
        "end_date.$": "$.date"
      },
      "Next": "RunParallel"
    },
    "RunParallel": {
      "Type": "Parallel",
      "Branches": [
        {
          "Comment": "GCLID Pipeline",
          "StartAt": "RunGlueJobGCLID",
          "States": {
            "RunGlueJobGCLID": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "addi_conv_gclid_youtube_test",
                "Arguments": {
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        },
        {
          "Comment": "Metric Pipeline",
          "StartAt": "RunGlueJobMetric",
          "States": {
            "RunGlueJobMetric": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "addi_conv_metric_youtube",
                "Arguments": {
                  "--start_date.$": "$.start_date",
                  "--end_date.$": "$.end_date"
                }
              },
              "ResultPath": null,
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "JobFailed"
        }
      ],
      "End": true
    },
    "JobFailed": {
      "Type": "Fail",
      "Error": "GlueJobFailed",
      "Cause": "One of the Glue jobs failed. Check CloudWatch Logs for details."
    }
  }
}
